# API
PORT=3001
METRICS_PORT=9464 # /metrics dos workers (a API usa a própria porta)

# PostgreSQL (mesmos nomes que a imagem oficial do postgres usa)
# 127.0.0.1 e não localhost: localhost resolve para ::1 primeiro, e o proxy IPv6 do Docker Desktop
# pode travar (o SDK da AWS espera para sempre). IPv4 explícito evita depender disso.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering

# SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
WAGER_EVENTS_QUEUE=wager-events.fifo
